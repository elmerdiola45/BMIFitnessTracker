<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_peach"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="40dp"
            android:text="@string/app_name"
            android:textColor="@color/text_brown"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:text="@string/body_metrics"
                    android:textColor="@color/text_brown"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxWidth="400dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height_cm"
                        android:textColor="@color/text_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/input_background_shape"
                        android:elevation="2dp"
                        android:padding="16dp">

                        <EditText
                            android:id="@+id/etHeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="40dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/height_hint"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:minHeight="48dp"
                            android:textColor="@color/text_brown"
                            android:textColorHint="@color/hint_color"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:text="@string/label_cm"
                            android:textColor="@color/text_brown"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weight_kg"
                        android:textColor="@color/text_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="36dp"
                        android:background="@drawable/input_background_shape"
                        android:elevation="2dp"
                        android:padding="16dp">

                        <EditText
                            android:id="@+id/etWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="40dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/weight_hint"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:minHeight="48dp"
                            android:textColor="@color/text_brown"
                            android:textColorHint="@color/hint_color"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:text="@string/label_kg"
                            android:textColor="@color/text_brown"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompute"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_gravity="center_horizontal"
                        android:maxWidth="320dp"
                        android:backgroundTint="@color/button_orange"
                        android:elevation="4dp"
                        android:text="@string/compute_bmi"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:cornerRadius="32dp"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:iconGravity="textEnd"
                        app:iconSize="24dp"
                        app:iconTint="@color/button_text_contrast" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:background="@drawable/info_background_shape"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="@color/icon_orange_dark" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi_info"
                        android:textColor="@color/text_brown"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BMI Result Section -->
        <LinearLayout
            android:id="@+id/resultLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR CURRENT BMI"
                android:textColor="@color/text_brown"
                android:textSize="12sp"
                android:textStyle="bold"
                android:alpha="0.6"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvBMIValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22.4"
                    android:textColor="@color/text_brown"
                    android:textSize="80sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBMILabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="-20dp"
                    android:background="@drawable/ideal_label_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="IDEAL"
                    android:textColor="#3D7E3D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:rotation="15"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvBMICategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:text="Normal Weight"
                android:textColor="@color/text_brown"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="32dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health Insight"
                            android:textColor="@color/text_brown"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="INDEX SCALE"
                            android:textColor="@color/text_brown"
                            android:textSize="10sp"
                            android:alpha="0.5" />
                    </RelativeLayout>

                    <!-- Custom BMI Scale UI -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:background="@drawable/bmi_scale_gradient" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18.5" android:textSize="10sp" android:alpha="0.5"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="25.0" android:textSize="10sp" android:alpha="0.5"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="30.0" android:textSize="10sp" android:alpha="0.5"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvInsightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/insight_dummy_text"
                        android:textColor="@color/text_brown"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Recommendation"
                        android:textColor="@color/text_brown"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRecommendationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/rec_dummy_text"
                        android:textColor="@color/text_brown"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvCategoryLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CATEGORY"
                                android:textSize="10sp"
                                android:alpha="0.5"/>
                            <TextView android:id="@+id/tvCategoryValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Optimal" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_brown"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RISK LEVEL" android:textSize="10sp" android:alpha="0.5"/>
                            <TextView android:id="@+id/tvRiskValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Low" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_brown"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Weight History Section -->
        <LinearLayout
            android:id="@+id/historyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEALTH METRICS"
                android:textColor="@color/text_brown"
                android:textSize="12sp"
                android:textStyle="bold"
                android:alpha="0.6"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight History"
                android:textColor="@color/text_brown"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryTrendInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your body mass index has decreased by 1.2 points in the last 30 days."
                android:textColor="@color/text_brown"
                android:textSize="16sp"
                android:alpha="0.8" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="32dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT BMI" android:textSize="10sp" android:alpha="0.5"/>
                        <TextView android:id="@+id/tvCurrentHistoryBMI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22.4" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/text_brown"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCurrentHistoryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/ideal_label_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="NORMAL"
                        android:textColor="#3D7E3D"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Past Records Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Past Records"
                    android:textColor="@color/text_brown"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Container for history items -->
            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Smart Insight Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="#FFF1D6"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_dialog_info" app:tint="#8B5E3C"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Smart Insight" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_brown"/>
                    <TextView
                        android:id="@+id/tvSmartInsightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Your BMI tends to drop following weeks where you log at least 4 high-intensity workouts. Maintain this consistency to reach your goal."
                        android:textColor="@color/text_brown"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:alpha="0.8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next Milestone Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFF1D6"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next Milestone" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_brown"/>
                    <TextView android:id="@+id/tvMilestoneTarget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Target BMI: 21.5" android:textSize="14sp" android:textColor="@color/text_brown" android:alpha="0.8"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/milestoneProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:progress="75"
                        app:trackColor="@android:color/white"
                        app:indicatorColor="@color/button_orange"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tvProgressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="75% ACHIEVED"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_brown"
                        android:alpha="0.5"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>